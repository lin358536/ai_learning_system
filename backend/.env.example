# ============================================================
# 智途校园 (.env.example) — 环境变量模板
# 用法：复制本文件为 .env 后按需填写（backend/ 目录下执行 `copy .env.example .env`）。
# 说明：所有占位值均为示例，请勿填入真实密钥；.env 已被 .gitignore 忽略，不会提交。
# ============================================================

# ── 数据库（必填）────────────────────────────────────────────
# MySQL 连接信息。DB_NAME 默认 ai_learning_system，建库后导入 docs/ai_learning_system.sql。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=ai_learning_system

# ── JWT 鉴权（必填）──────────────────────────────────────────
# 生产环境务必替换 JWT_SECRET_KEY 为随机长字符串；JWT_EXPIRE_HOURS 为 token 有效期（小时）。
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=168

# ── 本地 Agent 默认 LLM：DeepSeek（必填）────────────────────
# 本地 LangChain/LangGraph 智能体的默认大模型。DEEPSEEK_API_KEY 必填，
# 请到 https://platform.deepseek.com 申请；模型名以平台实际 ID 为准
# （默认 deepseek-flash；平台另有合法值 deepseek-v4-pro，按平台开通情况填写）。
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Agent 通道（必填）────────────────────────────────────────
# AGENT_BACKEND: langgraph（本地智能体，默认） | coze（扣子远程智能体，回退通道）
# AGENT_MAX_ITER: LangGraph 工具循环最大轮数（防死循环）
# PROMPT_HOT_RELOAD: 技能 YAML prompt 热加载开关（true/false）
AGENT_BACKEND=langgraph
AGENT_MAX_ITER=8
PROMPT_HOT_RELOAD=true

# ── LLM 采样参数（可选，留空则用默认值）──────────────────────
# LLM_TEMPERATURE: 采样温度（0~2，越大越发散）；LLM_MAX_TOKENS: 单次最大输出 token 数。
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── 扣子 Coze（可选，仅回退通道 AGENT_BACKEND=coze 时需要）──
# 不使用 Coze 时留空即可；启用 Coze 回退需填写有效的 COZE_PAT 与 COZE_BOT_ID。
COZE_PAT=
COZE_BOT_ID=

# ── 通义千问 Qwen（可选备用，本期不自动启用）────────────────
# 保留的备用 provider 配置，未启用时可留空。
QWEN_API_KEY=
QWEN_MODEL=qwen3.5-flash
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 邮件（可选，注册验证码等邮件功能需要）───────────────────
# SMTP_USER 为发件邮箱；SMTP_PASSWORD 通常为邮箱的「SMTP 授权码」而非登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_smtp_auth_code
