# ============================================================
# 智途校园 (.gitignore) — 敏感信息 / 构建产物 / 本地环境
# 目标：让别人 clone 下来「不含任何密钥、不含本地产物」，可直接跑起来（见 README.md）。
# 注意：本文件中的否定规则（! 开头）必须放在对应忽略规则之后才生效。
# ============================================================

# ── 环境变量与密钥（严禁提交）───────────────────────────────
.env
# 忽略所有 .env.* 变体（如 .env.bak / .env.local），但示例文件必须保留：
.env.*
!.env.example

# 明文密钥文件：项目根下的 api.txt（内含 DeepSeek API Key）
api.txt

# 备份文件（.bak 中可能含明文 Coze PAT / Qwen key / SMTP 授权码）
*.bak
*.bak.*

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# ── 虚拟环境 ────────────────────────────────────────────────
venv/
.venv/

# ── IDE / 编辑器 ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── 操作系统 ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 测试 ────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── 前端依赖 ────────────────────────────────────────────────
node_modules/

# ── 日志与工具配置 ──────────────────────────────────────────
# 工具配置（含 opencode.json 及其变体）
opencode.json*
# 所有日志文件（含测试服务日志 server_8123.log 等）
*.log
server_*.log
backend/server.log
backend/server_err.log

# ── 本地临时验证产物（QA / 回归脚本，勿提交）───────────────
_qa_verify/
_qa_round2/
_fix_verify/
_pytest_out.txt
_regression_out.txt
_regression_check.py

# ── 改前备份目录（本轮整理产生）─────────────────────────────
_cleanup_backup_*/

# ── 疑似废弃的复制 / 新版本文件 ─────────────────────────────
*.copy
*.new_version
